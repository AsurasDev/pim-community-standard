# Bootstrap del esquema de Directus por API (alternativa a `schema apply`).
DIRECTUS_URL=https://directus.example.com
DIRECTUS_EMAIL=admin@onix.local
DIRECTUS_PASSWORD=replace-me

# Lectura del catálogo ONIX para sincronizar hacia Akeneo.
# En Railway se resuelve como ${{PostGIS.DATABASE_URL}}.
DIRECTUS_DATABASE_URL=postgresql://user:password@host:5432/railway

# Akeneo PIM. El cliente OAuth se crea con:
#   php bin/console pim:oauth-server:create-client "onix-sync"
# y el usuario con:
#   php bin/console pim:user:create onix_sync '<clave>' correo@ejemplo.com ONIX Sync es_ES --admin -n
AKENEO_BASE_URL=https://akeneo.example.com
AKENEO_CLIENT_ID=replace-me
AKENEO_CLIENT_SECRET=replace-me
AKENEO_USERNAME=onix_sync
AKENEO_PASSWORD=replace-me

# Bearer que protege el disparador HTTP de `server.mjs`.
# Si se deja vacío, el endpoint queda abierto.
SYNC_SECRET=replace-me
PORT=3000
